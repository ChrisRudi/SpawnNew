{
  "schemaVersion": 1,
  "configVersion": "1.0",
  "comment": "config/spawnnew.settings.default.json - mitgelieferte Standardkonfiguration. Benutzerwerte gehoeren nach %LOCALAPPDATA%\\SpawnNew\\spawnnew.settings.json und werden nie von einem Update ueberschrieben.",
  "sourceTimeoutMs": 1500,
  "cacheMaxAgeMinutes": 1440,
  "scanDepth": 3,
  "sources": [
    {
      "name": "Persoenliche Aktionen",
      "path": "%LOCALAPPDATA%\\SpawnNew\\Actions",
      "scope": "personal",
      "order": 100
    },
    {
      "name": "Mitgelieferte Aktionen",
      "path": "%SPAWNNEW_APP%\\Actions",
      "scope": "shared",
      "order": 900
    }
  ],
  "install": {
    "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%SPAWNNEW_APP%\\Install-SpawnNew.ps1\" -Scope CurrentUser",
    "requiresAdmin": false
  },
  "update": {
    "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%SPAWNNEW_APP%\\Install-SpawnNew.ps1\" -Scope CurrentUser -Update",
    "requiresAdmin": false
  }
}
