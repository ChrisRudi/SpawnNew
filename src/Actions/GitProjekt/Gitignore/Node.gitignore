# Node.gitignore - mitgelieferte Vorlage der Aktion Git-Projekt

# Abhaengigkeiten
node_modules/
.pnp.*
.yarn/cache/

# Build-Ergebnisse
dist/
build/
.next/
out/
coverage/

# Protokolle
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Umgebung
.env
.env.local
.env.*.local

# Betriebssystem und Editoren
Thumbs.db
Desktop.ini
.vscode/
.idea/
