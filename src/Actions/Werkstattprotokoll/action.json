{
  "schemaVersion": 1,
  "id": "spawnnew.workshoplog",
  "title": "Werkstättenprotokoll",
  "category": "",
  "entryPoint": "Invoke-SpawnAction.ps1",
  "requiresAdmin": false,
  "supportsCancel": true,
  "allowsOverwrite": false,
  "targetKind": "folder",
  "nameTemplate": "{{datum}} {{klasse}} {{thema}}",
  "fields": [
    { "name": "klasse", "label": "Klasse", "type": "text", "required": true },
    { "name": "thema", "label": "Thema", "type": "text", "required": true },
    { "name": "datum", "label": "Datum", "type": "date", "required": true, "default": "today" },
    { "name": "format", "label": "Ausgabeformat", "type": "choice", "choices": [ "Markdown", "Word" ], "default": "Word" },
    { "name": "entwurf", "label": "Entwurf vom Sprachmodell", "type": "bool", "default": "false" }
  ],
  "plannedSteps": [
    "Ordner 'Datum Klasse Thema' anlegen",
    "Protokollvorlage im gewaehlten Format anlegen",
    "Ordner Bilder und Messdaten anlegen",
    "Optional: Protokoll.Entwurf.md vom Sprachmodell als gekennzeichneten Entwurf anlegen"
  ]
}
